# Copy to .env. Never commit .env.

# Same Postgres as the data service (db/docker-compose.yml). Research tables are prefixed research_.
DATABASE_URL=postgresql://siemens:siemens@localhost:5433/siemenslabs

# LLM: same variables as the frontend. Any OpenAI-compatible endpoint, default NVIDIA build.nvidia.com.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
