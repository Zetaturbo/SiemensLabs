{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm gen:openui && next dev",
    "build": "pnpm gen:openui && next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript $DATA_API_URL/openapi.json -o src/lib/data-api/schema.d.ts",
    "gen:openui": "tsx src/lib/prompt/gen-openui.ts",
    "eval:routing": "pnpm gen:openui && tsx evals/routing/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-lang": "^1.0.1",
    "@paper-design/shaders": "0.0.72",
    "@paper-design/shaders-react": "0.0.72",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.23.0"
}
