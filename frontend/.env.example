# Copy to .env and fill LLM_API_KEY. Never commit .env.

# LLM: any OpenAI-compatible endpoint. Default NVIDIA build.nvidia.com.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Default: Nemotron 3 Ultra (30/30 routing, TTFT median ~0.9 s). Fallback: nvidia/nemotron-3-super-120b-a12b.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Reasoning (thinking) adds seconds before the first answer token; off by default.
LLM_REASONING=off

# Data: every tool call resolves per call, in this order (src/lib/data-api/client.ts):
#   1. live    POST {DATA_API_URL}/tools/<tool>, 3 s timeout. Only when DATA_API_URL is set and DATA_API_MOCK is not 1.
#   2. engine  on connection error, timeout or 404 (tool not built yet): computed from ../data/supplier_risk_dataset.csv.
#   3. mock    when the engine lacks the tool (find_similar): src/lib/data-api/mocks/<tool>.json.
#   run_sql is live only: without the service it returns ok:false, code NOT_AVAILABLE (no canned mock table).
# Responses carry meta.source = live | engine | mock; each fallback logs one line. Check with `pnpm check:data`.
DATA_API_URL=http://localhost:8000
# 1 = skip the live service (engine, then static mocks). 0 = live service first.
DATA_API_MOCK=1

# Research agent job API. Empty = replay mode (canned Knorr-Bremse progress and report).
RESEARCH_API_URL=
